{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(img|video|audio)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(nights|signal|request)",
      "destination": "/"
    }
  ]
}