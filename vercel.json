{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(img|video|audio)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/argana",
      "destination": "https://arganamusic.com/",
      "permanent": true
    },
    {
      "source": "/argana/:path*",
      "destination": "https://arganamusic.com/:path*",
      "permanent": true
    }
  ]
}
