{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "alma-social-club.vercel.app" }],
      "destination": "https://almasocial.club/:path*",
      "permanent": true
    }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
